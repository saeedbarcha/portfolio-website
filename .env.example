# Required for SEO: canonical URLs, Open Graph, JSON-LD, sitemap.xml, and robots.txt.
# Google will not treat relative sitemap/canonical URLs as complete. Set this before deploy.
# Example: https://saeedhussain.dev
VITE_SITE_URL=

# Optional form backend so messages arrive without opening the visitor's email app.
# Formspree: https://formspree.io/f/yourid
# Getform: https://getform.io/f/yourid
# If empty, the contact form falls back to a mailto: draft using the email in src/data/personal.js
VITE_CONTACT_ENDPOINT=
